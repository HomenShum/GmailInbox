{
  "name": "gmail-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "seed": "tsx scripts/seed.ts",
    "nodebench:api": "powershell -ExecutionPolicy Bypass -File scripts/start-nodebench-api.ps1",
    "nodebench:top-jobs": "tsx scripts/run-nodebench-top-jobs.ts",
    "identity:all-time": "node scripts/analyze-all-time-identity-map.mjs",
    "gmail:body-ingest": "tsx scripts/ingest-private-thread-bodies.ts",
    "private-context:status": "tsx scripts/private-context-status.ts",
    "private-context:judge": "tsx scripts/judge-private-context-shards.ts",
    "private-context:promote": "tsx scripts/promote-private-identity-claims.ts",
    "verify:nodebench": "tsx scripts/verify-nodebench-bridge.ts",
    "public:export": "node scripts/create-public-export.mjs",
    "demo:readme-gif": "python scripts/make-readme-gif.py",
    "demo:video:audio": "node scripts/make-gmail-demo-audio.mjs",
    "demo:video": "npm run demo:video:audio && remotion render remotion/index.ts GmailAgentDemo public/demo/gmail-agent-memory-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --port=3038",
    "demo:video:vertical": "npm run demo:video:audio && remotion render remotion/index.ts GmailAgentDemoVertical public/demo/gmail-agent-memory-demo-vertical.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --port=3039",
    "demo:video:preview": "remotion preview remotion/index.ts --port=3038",
    "mcp": "tsx mcp-server/src/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.70.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sinclair/typebox": "0.34.41",
    "better-sqlite3": "11.10.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "hono": "4.12.15",
    "lucide-react": "0.474.0",
    "next": "16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.456",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "playwright": "^1.59.1",
    "postcss": "8.4.49",
    "remotion": "^4.0.456",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
